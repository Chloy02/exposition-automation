{
  "manifest_version": 3,
  "name": "Exposition Email Automator",
  "version": "2.4",
  "description": "Extracts data and images from Gmail for exposition purposes with Haar Cascade face detection.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://face-recognise.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://face-recognise.vercel.app/*"],
      "js": ["autofill.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "simpleFaceDetection.js",
        "trackingFaceDetection.js",
        "lib/tracking.js",
        "lib/face.js",
        "offscreen.html",
        "offscreen.js",
        "debug_attachments.js",
        "debug.html"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://face-recognise.vercel.app/*",
        "<all_urls>"
      ]
    }
  ]
}
